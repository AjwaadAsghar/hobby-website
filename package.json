{
  "name": "hobby-shobby",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/setup.ts",
    "dev": "next dev",
    "build": "tsx scripts/prepare-db.ts && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "setup": "tsx scripts/setup.ts",
    "vercel-build": "tsx scripts/prepare-db.ts && prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts && next build",
    "postinstall": "prisma generate",
    "db:push": "tsx scripts/with-env.ts prisma db push",
    "db:seed": "tsx scripts/with-env.ts tsx prisma/seed.ts",
    "db:reset": "tsx scripts/with-env.ts prisma db push --force-reset --skip-generate && tsx scripts/with-env.ts tsx prisma/seed.ts --force",
    "db:studio": "tsx scripts/with-env.ts prisma studio",
    "vapid": "tsx scripts/vapid.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.5.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "resend": "^6.33.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
