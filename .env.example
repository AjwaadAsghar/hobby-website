# =============================================================================
#  Environment variables
#  Copy this file to .env.local and fill in what you have. EVERYTHING here is
#  optional for running the store on your own computer: `npm run dev` creates
#  .env.local for you with safe local values.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE  (required in production)
# Locally: a file called prisma/dev.db is used automatically. Nothing to do.
# Production: paste a free Neon or Supabase PostgreSQL connection string.
# The code switches between SQLite and PostgreSQL automatically.
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"


# -----------------------------------------------------------------------------
# LOGIN SECURITY  (required in production)
# A long random password used to sign login cookies. Generated for you locally.
# For production, generate one at https://generate-secret.vercel.app/32
# -----------------------------------------------------------------------------
AUTH_SECRET=""


# -----------------------------------------------------------------------------
# WEBSITE ADDRESS  (required in production)
# The public address of your store. Used in emails, Telegram links and SEO.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# IMAGE UPLOADS - Cloudinary  (optional locally, strongly recommended online)
# Without these, uploads are saved to public/uploads on your computer.
# On Vercel, files saved to disk disappear, so add Cloudinary before going live.
# Free account: https://cloudinary.com  -> Dashboard -> "API Keys"
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# -----------------------------------------------------------------------------
# EMAIL - Resend  (optional)
# Without a key, emails are printed in the terminal and saved in
# Admin -> Integrations -> Email log, so nothing is lost.
# Free account: https://resend.com -> API Keys
# EMAIL_FROM must use a domain you verified in Resend. For quick testing you can
# use "onboarding@resend.dev" (it can only send to your own Resend email).
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"


# -----------------------------------------------------------------------------
# TELEGRAM NEW-ORDER ALERTS  (optional)
# Create a bot with @BotFather to get the token, then find your chat ID
# (see SETUP_CHECKLIST.md for step-by-step instructions).
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""


# -----------------------------------------------------------------------------
# BROWSER PUSH NOTIFICATIONS  (optional)
# Generated for you locally. For production run `npm run vapid` and copy the
# three lines it prints.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
